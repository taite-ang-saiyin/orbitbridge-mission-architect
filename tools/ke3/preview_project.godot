; LOCAL PREVIEW ONLY. SE owns the team's startup settings; do not merge this file.
config_version=5

[application]
config/name="OrbitBridge KE3 SYNTHETIC Outline Preview"
run/main_scene="res://ke3/operations_control.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
