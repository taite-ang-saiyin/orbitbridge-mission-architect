+func apply_v2_preset(config: Dictionary) -> void:
+	if state.get("active_run_state", {}).get("phase") == "operating":
+		return
+	Catalog.reset(state)
+	state.name = config.mission.title
+	state.objective = config.mission.objective
+	state.targets = config.mission.get("target_regions", [config.mission.target_region]).map(func(id): return Runtime.TARGETS.find_key(id))
+	state.target = state.targets[0]
+	state.target_limit = state.targets.size()
+	state.observations = config.mission.required_observations
+	state.required_returned_data_mb = config.mission.required_returned_data_mb
+	state.duration = config.mission.duration_orbits
+	state.budget = config.mission.budget_credits
+	state.orbit = Runtime.ORBITS.find_key(config.design.orbit_id)
+	for field in ["schema_version", "contract_revision", "preset_id", "preset_revision"]:
+		state[field] = config[field]
+	state.goal = config.mission.goal.duplicate(true)
+	state.engineering_parts = {}
+	for category in ["bus", "instrument", "solar", "battery", "radio", "storage"]:
+		state.engineering_parts[category] = config.design[category + "_id"]
+	state.launch_profile_id = config.design.launch_profile_id
+	state.launcher_id = config.design.launcher_id
+	navigate.emit(1)
+
 func apply_preset(entry: Array) -> void:
