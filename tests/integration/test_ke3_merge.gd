extends SceneTree
const Runtime = preload("res://scripts/integration/mission_runtime.gd")
const Catalog = preload("res://data/mock/DesignCatalog.gd")
const Presenter = preload("res://scripts/presentation/DebriefPresentation.gd")
var passed: int = 0
var failed: int = 0
func _initialize() -> void:
	call_deferred("run")
func settle() -> void:
	for frame in 8: await process_frame
func check(value: bool, label: String) -> void:
	if value: passed += 1
	else:
		failed += 1
		printerr("FAIL: " + label)
func run() -> void:
	var app = load("res://scenes/Main.tscn").instantiate()
	root.add_child(app)
	preload("res://scripts/verification/demo_verification.gd").new().fresh(app)
	app.show_screen(4)
	await settle()
	check(app.current.action_buttons.size() == 3, "Manual actions survive the KE3 merge")
	app.current.take_action("power_save")
	check(app.state.active_run_state.step_index == 1, "Manual action reaches the native engine")
	check(app.current.details.text.contains("evt_") and app.current.telemetry.text.contains("Step 1 /"), "KE3 event identity and step telemetry are visible")
	app.current.skip_to_end()
	app.show_screen(5)
	await settle()
	var original: Dictionary = app.state.run_trace.duplicate(true)
	var id: String = original.final_state.run_id
	var store: Dictionary = app.state.evaluation_store.duplicate(true)
	check(app.current.flight_facts.text.contains("Equator:") and app.current.flight_facts.text.contains("captures"), "Main's per-target totals remain visible in KE3 Results")
	check(app.current.same_mission_button.text == "Retry same mission" and app.current.retry_button.text == "Modify design", "Both user-selected intents are clearly labelled")
	app.current.same_mission_button.pressed.emit()
	await settle()
	check(app.current.screen_id == "MissionOperations" and app.retry_restore.is_empty(), "Same-mission button starts immediately")
	check(app.state.run_trace.config == original.config and app.state.run_trace.catalogs_snapshot == original.catalogs_snapshot, "Same-mission retry retains frozen config and catalogs")
	check(app.state.active_run_state.step_index == 0 and app.state.active_run_state.event_log.is_empty(), "Immediate retry starts clean")
	check(app.state.active_run_state.run_id != id and app.state.active_run_state.mission_id == original.final_state.mission_id, "Retry has a new run ID within the same mission")
	check(app.state.evaluation_store == store, "Immediate retry leaves existing reports untouched")
	app.current.skip_to_end()
	app.show_screen(5)
	await settle()
	var before_edit: Dictionary = app.state.duplicate(true)
	app.current.retry_button.pressed.emit()
	await settle()
	check(app.current.screen_id == "SpacecraftBuilder" and not app.retry_restore.is_empty(), "Modify design opens an owned draft")
	app.current.select_engineering_component("instrument", "instrument_advanced")
	check(app.current.next_button.disabled, "Invalid changed design remains blocked")
	app.cancel_retry()
	await settle()
	check(app.current.screen_id == "DebriefCompare" and app.state == before_edit, "Cancel restores the complete original session exactly")
	app.current.retry_button.pressed.emit()
	await settle()
	app.current.select_engineering_component("radio", "radio_fast")
	# Acknowledge fixture mission intent; engineering checks still run.
	assert(preload("res://scripts/integration/mission_review.gd").confirm(app.state, preload("res://scripts/integration/mission_review.gd").snapshot(app.state)))
	app.current.next_button.pressed.emit()
	await settle()
	check(app.current.screen_id == "FlightReadiness" and not app.current.next_button.disabled, "Edited radio reaches real passing readiness")
	# Acknowledge fixture mission intent; engineering checks still run.
	assert(preload("res://scripts/integration/mission_review.gd").confirm(app.state, preload("res://scripts/integration/mission_review.gd").snapshot(app.state)))
	app.current.next_button.pressed.emit()
	await settle()
	check(app.current.screen_id == "MissionOperations" and app.retry_restore.is_empty(), "Launching the changed design completes the edit transaction")
	check(app.state.run_trace.config.mission == original.config.mission and app.state.run_trace.config.design.radio_id == "radio_fast", "Changed design retains mission requirements")
	check(app.state.evaluation_store.reports[id] == store.reports[id], "Earlier report stays immutable through changed-design launch")
	var operating = app.current
	app.request_screen(1)
	check(app.current == operating, "SE Creator navigation cannot edit a live run")
	app.flow_error.hide()
	app.request_screen(3)
	check(app.current == operating, "SE Readiness navigation cannot edit a live run")
	app.flow_error.hide()
	app.show_screen(2)
	check(app.current == operating, "Editing remains blocked while operating")
	app.flow_error.hide()
	app.show_screen(5)
	check(app.current == operating, "Early Results remain blocked")
	app.flow_error.hide()
	app.abort_current_run("KE3 merge abort check")
	await settle()
	check(app.current.get_presentation_model().report.score == null, "Aborted changed design has no numeric score")
	var trace: Dictionary = app.state.run_trace.duplicate(true)
	var invalid_store: Dictionary = app.state.evaluation_store.duplicate(true)
	invalid_store.reports[trace.final_state.run_id].required_observations += 1
	app.state.evaluation_store = invalid_store
	app.show_screen(5)
	await settle()
	check(app.current.get_presentation_model().state == "stale_report", "Changed report goals cannot attach to a recorded execution")
	check(app.current.same_mission_button.disabled and app.current.retry_button.disabled, "Rejected report disables both retry intents")
	var first: Dictionary = Catalog.DEFAULTS.duplicate(true)
	var second: Dictionary = Catalog.DEFAULTS.duplicate(true)
	var a: Dictionary = Runtime.launch(first)
	var b: Dictionary = Runtime.launch(second)
	check(a.ok and b.ok and first.run_session_id != second.run_session_id and a.trace.final_state.run_id != b.trace.final_state.run_id, "Independent sessions have distinct namespaced identities")
	app.queue_free()
	await settle()
	print("KE3 merged intents: %d checks passed; %d failed." % [passed, failed])
	quit(0 if failed == 0 else 1)
