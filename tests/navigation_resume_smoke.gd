extends SceneTree
const Runtime = preload("res://scripts/integration/mission_runtime.gd")
const Review = preload("res://scripts/integration/mission_review.gd")
func _initialize() -> void:
	create_timer(45).timeout.connect(func(): push_error("Navigation test timed out"); quit(1))
	call_deferred("run")
func settle() -> void:
	for frame in 8: await process_frame
func run() -> void:
	for mission in ["imaging", "communication", "weather_monitoring"]:
		var app = load("res://scenes/Main.tscn").instantiate()
		root.add_child(app)
		await settle()
		app.show_screen(0)
		await settle()
		assert(not app.find_child("SettingsMenu", true, false).visible)
		assert(app.find_child("SetupHome", true, false).visible)
		if mission != "imaging": assert(Runtime.select_preset(app.state, mission).ok)
		assert(Review.confirm(app.state, Review.snapshot(app.state)))
		assert(Runtime.launch(app.state).ok)
		var config: Dictionary = app.state.run_trace.config.duplicate(true)
		app.show_screen(4)
		await settle()
		app.current.pause()
		app.current.step()
		await settle()
		var snapshot: Dictionary = app.state.active_run_state.duplicate(true)
		app.return_to_start()
		await settle()
		assert(app.current.screen_id == "Home" and app.current.resume_available)
		assert(app.state.active_run_state == snapshot)
		app.resume_from_start()
		await settle()
		assert(app.current.screen_id == "MissionOperations" and not app.current.playing)
		assert(app.state.active_run_state == snapshot and app.state.run_trace.config == config)
		app.current.skip_to_end()
		await settle()
		app.show_screen(5)
		await settle()
		var key: String = app.current.get_presentation_model().execution_key
		app.return_to_start()
		await settle()
		app.resume_from_start()
		await settle()
		assert(app.current.screen_id == "DebriefCompare" and app.current.get_presentation_model().execution_key == key)
		assert(app.current.has_method("open_design_lab"))
		app.current.open_design_lab()
		await settle()
		assert(app.current.report_tabs.current_tab == 3)
		app.queue_free()
		await settle()
		print("PASS ", mission, ": setup header preserved, paused native-frame resume, exact result resume and Design Lab shortcut")
	quit(0)
